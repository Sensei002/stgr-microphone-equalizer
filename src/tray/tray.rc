// STGR Tray resources.
#include <windows.h>
#include "../gui/resource.h"

IDI_TRAY ICON "..\\..\\assets\\icons\\tray.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "STGR"
            VALUE "FileDescription", "STGR Tray"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "STGR Microphone Equalizer"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
